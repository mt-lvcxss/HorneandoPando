# Copia este archivo como .env.local (desarrollo) y completa los valores.
# Los archivos .env.*.local están en .gitignore: nunca se suben al repositorio.

# URL del proyecto de Supabase (Project Settings → Data API).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave PUBLICABLE (publishable / anon). Es pública por diseño: la seguridad la da RLS.
# NUNCA pongas aquí la clave secret / service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=

# URL pública de la app (enlaces de los correos). Cambia al dominio propio cuando exista.
VITE_APP_URL=http://localhost:5173

# Marca del producto (permite publicarlo con otro nombre sin tocar el código).
VITE_APP_NAME=Horneando Pando

# Correo de soporte que se muestra a los usuarios (opcional).
VITE_SUPPORT_EMAIL=
